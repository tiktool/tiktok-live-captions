{
    "name": "@tiktool/captions",
    "version": "1.0.3",
    "description": "Deprecated for new users. Legacy TikTok Live Captions client for existing caption customers; the service is no longer offered to new customers.",
    "author": "tiktool",
    "license": "MIT",
    "keywords": [
        "tiktok",
        "tiktok-live",
        "captions",
        "deprecated"
    ],
    "homepage": "https://tik.tools/docs#captions",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tiktool/captions.git"
    },
    "bugs": {
        "url": "https://github.com/tiktool/captions/issues"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsup",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "tsup": "^8.3.0",
        "typescript": "^5.7.0",
        "@tiktool/live": "2.6.7"
    },
    "engines": {
        "node": ">=18"
    }
}
